# Copia este archivo a ".env" y ajusta los valores. ".env" no se sube a Git.
# Todos los valores de este archivo son ficticios y solo valen para desarrollo local.

POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=pulsewatch

# Puerto del equipo donde se publica PostgreSQL (dentro de Docker sigue siendo 5432).
# 5433 evita chocar con un PostgreSQL local que ya use el 5432.
POSTGRES_PORT=5433

# Dirección de la base de datos para el backend (SQLAlchemy y Alembic).
# Repite el usuario, la contraseña, el puerto y el nombre de arriba: si los cambias, cámbialos aquí también.
# Se usa 127.0.0.1 y no "localhost": en Windows "localhost" puede resolver antes a IPv6 (::1),
# donde Docker no publica el puerto, y la conexión se queda esperando sin dar error.
DATABASE_URL=postgresql+psycopg://pulsewatch:change-me-dev-only@127.0.0.1:5433/pulsewatch
